service_project_id      = "your-vdi-service-project"
host_project_id         = "your-vdi-host-project"
enable_shared_vpc       = true
region                  = "us-central1"
zone                    = "us-central1-a"
domain                  = "vdi.corp.example.com"
enable_cloud_dns        = false # Set true for native GCP Cloud DNS (~$0.20/mo); keep false for Cloudflare DNS-only (gray cloud)
oauth_client_id         = "REPLACE_WITH_OAUTH_CLIENT_ID.apps.googleusercontent.com"
oauth_client_secret     = "REPLACE_WITH_OAUTH_CLIENT_SECRET"
allowed_emails          = ["admin@corp.example.com"]
broker_register_secret  = "replace-with-a-random-32-char-secret"
enable_rustdesk_pro     = false
desktop_machine_type    = "e2-standard-4"
enable_browser_fallback = false
