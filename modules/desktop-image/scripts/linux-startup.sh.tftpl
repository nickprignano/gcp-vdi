#!/usr/bin/env bash
set -euo pipefail

META="http://metadata.google.internal/computeMetadata/v1"
H="Metadata-Flavor: Google"
OWNER_EMAIL=$(curl -fsSL -H "$H" "$META/instance/attributes/vdi-owner-email" || echo "unknown@local")
OWNER_HASH=$(curl -fsSL -H "$H" "$META/instance/attributes/vdi-owner-hash" || echo "default")
DARK_MODE=$(curl -fsSL -H "$H" "$META/instance/attributes/vdi-dark-mode" || echo "true")
VM_NAME=$(curl -fsSL -H "$H" "$META/instance/name")
ZONE=$(curl -fsSL -H "$H" "$META/instance/zone" | awk -F/ '{print $NF}')
PROJECT=$(curl -fsSL -H "$H" "$META/project/project-id")

export DEBIAN_FRONTEND=noninteractive
if ! command -v rustdesk >/dev/null 2>&1; then
  apt-get update -qq
  apt-get install -y -qq xfce4 xfce4-goodies arc-theme dbus-x11 xdg-utils rclone fuse3 curl wget jq \
    git tmux htop vim unzip zip dnsutils net-tools iputils-ping traceroute openssh-client \
    python3 python3-pip python3-venv %{ if enable_browser_fallback }xrdp%{ endif }
  curl -fsSL -o /tmp/rustdesk.deb "https://github.com/rustdesk/rustdesk/releases/download/1.3.2/rustdesk-1.3.2-x86_64.deb"
  apt-get install -y -qq /tmp/rustdesk.deb || apt-get install -f -y -qq
  rm -f /tmp/rustdesk.deb
  curl -fsSL -o /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
  apt-get install -y -qq /tmp/chrome.deb || apt-get install -f -y -qq
  rm -f /tmp/chrome.deb
fi

# Suppress GNOME Keyring prompts under xrdp ephemeral passwords
apt-get purge -y -qq gnome-keyring >/dev/null 2>&1 || true
for f in /etc/xdg/autostart/gnome-keyring-*.desktop; do
  [ -f "$f" ] && grep -q '^Hidden=' "$f" || { [ -f "$f" ] && echo "Hidden=true" >> "$f"; }
done
cat <<'EOF' > /usr/local/bin/google-chrome
#!/usr/bin/env bash
exec /usr/bin/google-chrome --password-store=basic "$@"
EOF
chmod +x /usr/local/bin/google-chrome
if [ -f /usr/share/applications/google-chrome.desktop ]; then
  sed -i 's|/usr/bin/google-chrome-stable|/usr/local/bin/google-chrome|g' /usr/share/applications/google-chrome.desktop || true
fi

id -u vdi >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo vdi
echo "vdi ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/vdi

# Configure rclone for GCS using GCE VM service account
mkdir -p /root/.config/rclone
cat <<'EOF' > /root/.config/rclone/rclone.conf
[gcs]
type = google cloud storage
env_auth = true
bucket_policy_only = true
EOF

# Restore user home directory from GCS
rclone sync "gcs:${home_bucket_name}/users/$OWNER_HASH/home" /home/vdi --create-empty-src-dirs || true
mkdir -p /home/vdi/.config/xfce4/xfconf/xfce-perchannel-xml
if [ ! -f /home/vdi/.config/xfce4/helpers.rc ]; then
  echo "WebBrowser=google-chrome" > /home/vdi/.config/xfce4/helpers.rc
fi
if [ "$DARK_MODE" = "true" ]; then
  GTK_THEME="Arc-Dark"
  PANEL_DARK="true"
else
  GTK_THEME="Arc"
  PANEL_DARK="false"
fi
cat <<EOF > /home/vdi/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="$GTK_THEME"/>
  </property>
</channel>
EOF
cat <<EOF > /home/vdi/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="$GTK_THEME"/>
  </property>
</channel>
EOF
cat <<EOF > /home/vdi/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="panels" type="empty">
    <property name="dark-mode" type="bool" value="$PANEL_DARK"/>
  </property>
</channel>
EOF
chown -R vdi:vdi /home/vdi

# Fetch RustDesk public key from GCS and configure client
PUB_KEY=$(gcloud storage cat "gs://${home_bucket_name}/rustdesk/id_ed25519.pub" 2>/dev/null || true)
mkdir -p /home/vdi/.config/rustdesk /root/.config/rustdesk
cat <<EOF > /root/.config/rustdesk/RustDesk2.toml
rendezvous_server = '${rustdesk_host}:21116'
nat_type = 1
serial = 0

[options]
custom-rendezvous-server = '${rustdesk_host}'
relay-server = '${rustdesk_host}'
key = '$PUB_KEY'
EOF
cp /root/.config/rustdesk/RustDesk2.toml /home/vdi/.config/rustdesk/RustDesk2.toml
chown -R vdi:vdi /home/vdi/.config/rustdesk

# Generate ephemeral per-boot password and register with broker
EPHEMERAL_PW=$(openssl rand -hex 10)
%{ if enable_browser_fallback }
echo "vdi:$EPHEMERAL_PW" | chpasswd
echo "xfce4-session" > /home/vdi/.xsession
chown vdi:vdi /home/vdi/.xsession
systemctl enable --now xrdp
%{ endif }
systemctl enable --now rustdesk
RD_ID=""
for _ in $(seq 1 10); do
  sleep 2
  RD_ID=$(HOME=/root rustdesk --get-id 2>/dev/null | tr -d '\r\n' || true)
  if [[ "$RD_ID" =~ ^[0-9]+$ ]]; then
    break
  fi
done
HOME=/root rustdesk --password "$EPHEMERAL_PW" || true
if [ -z "$RD_ID" ]; then
  RD_ID="$VM_NAME"
fi

PAYLOAD=$(jq -n \
  --arg owner "$OWNER_EMAIL" \
  --arg vm "$VM_NAME" \
  --arg id "$RD_ID" \
  --arg pw "$EPHEMERAL_PW" \
  '{owner_email:$owner, vm_name:$vm, kind:"gcp-spot", rustdesk_id:$id, ephemeral_password:$pw}')

curl -fsSL -X POST "${broker_register_url}" \
  -H "Authorization: Bearer ${broker_register_secret}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" || true

# Periodic 5-min rclone sync + Spot preemption shutdown hook + idle reaper
cat <<EOF > /usr/local/bin/vdi-sync.sh
#!/usr/bin/env bash
rclone sync /home/vdi "gcs:${home_bucket_name}/users/$OWNER_HASH/home" --exclude ".cache/**" --exclude "GoogleDrive/**"
EOF
chmod +x /usr/local/bin/vdi-sync.sh

# Auto-mount ~/GoogleDrive when [gdrive] remote exists in ~/.config/rclone/rclone.conf (persisted in GCS)
cat <<'EOF' > /usr/local/bin/mount-gdrive.sh
#!/usr/bin/env bash
set -euo pipefail
mkdir -p /home/vdi/GoogleDrive
if grep -q '^\[gdrive\]' /home/vdi/.config/rclone/rclone.conf 2>/dev/null; then
  exec rclone mount gdrive: /home/vdi/GoogleDrive \
    --config /home/vdi/.config/rclone/rclone.conf \
    --vfs-cache-mode writes \
    --vfs-cache-max-age 1h \
    --dir-cache-time 30s
fi
EOF
chmod +x /usr/local/bin/mount-gdrive.sh

cat <<'EOF' > /usr/local/bin/connect-gdrive
#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/.config/rclone" "$HOME/GoogleDrive"
echo "Follow the prompt to authorize Google Drive (remote name: gdrive)..."
rclone config create gdrive drive scope=drive
sudo systemctl restart vdi-gdrive
echo "Mounted at ~/GoogleDrive (persisted across Spot VMs via GCS)."
EOF
chmod +x /usr/local/bin/connect-gdrive

cat <<'EOF' > /etc/systemd/system/vdi-gdrive.service
[Unit]
Description=Mount Google Drive at ~/GoogleDrive
After=network-online.target
[Service]
User=vdi
Group=vdi
ExecStart=/usr/local/bin/mount-gdrive.sh
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
EOF
systemctl enable --now vdi-gdrive || true

cat <<'EOF' > /etc/systemd/system/vdi-sync.service
[Unit]
Description=Sync /home/vdi to GCS
[Service]
Type=oneshot
ExecStart=/usr/local/bin/vdi-sync.sh
EOF

cat <<'EOF' > /etc/systemd/system/vdi-sync.timer
[Unit]
Description=Periodic GCS home sync
[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
EOF
systemctl enable --now vdi-sync.timer

# Idle reaper (self-delete after idle_timeout_minutes)
cat <<EOF > /usr/local/bin/vdi-reaper.sh
#!/usr/bin/env bash
IDLE_MINS=\$(awk '{print int(\$1/60)}' /proc/uptime)
if [ "\$IDLE_MINS" -ge ${idle_timeout_minutes} ] && ! pgrep -x rustdesk >/dev/null; then
  /usr/local/bin/vdi-sync.sh
  gcloud compute instances delete "$VM_NAME" --zone="$ZONE" --project="$PROJECT" --quiet
fi
EOF
chmod +x /usr/local/bin/vdi-reaper.sh
