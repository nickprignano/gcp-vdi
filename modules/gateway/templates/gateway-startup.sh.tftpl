#!/usr/bin/env bash
set -euo pipefail

# Swap + ZRAM headroom for Always-Free e2-micro (1 GB RAM)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq docker.io docker-compose-v2 unattended-upgrades caddy

mkdir -p /opt/gcp-vdi /var/lib/gcp-vdi /var/lib/rustdesk

# Write Caddyfile
cat <<'EOF' > /etc/caddy/Caddyfile
${caddyfile}
EOF
systemctl enable --now caddy
systemctl reload caddy

# Write authenticated emails allowlist
cat <<'EOF' > /opt/gcp-vdi/allowed_emails.txt
${allowed_emails_text}
EOF

# Write docker-compose stack
cat <<'EOF' > /opt/gcp-vdi/docker-compose.yml
services:
  oauth2-proxy:
    image: quay.io/oauth2-proxy/oauth2-proxy:v7.7.1
    container_name: oauth2-proxy
    network_mode: host
    restart: unless-stopped
    environment:
      OAUTH2_PROXY_PROVIDER: google
      OAUTH2_PROXY_CLIENT_ID: "${oauth_client_id}"
      OAUTH2_PROXY_CLIENT_SECRET: "${oauth_client_secret}"
      OAUTH2_PROXY_COOKIE_SECRET: "${cookie_secret}"
      OAUTH2_PROXY_HTTP_ADDRESS: "127.0.0.1:4180"
      OAUTH2_PROXY_UPSTREAMS: "${enable_browser_fallback == "true" ? "${broker_upstream}/,http://127.0.0.1:8081/guacamole/" : broker_upstream}"
      OAUTH2_PROXY_REDIRECT_URL: "https://${site_host}/oauth2/callback"
      OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE: "/etc/oauth2-proxy/allowed_emails.txt"
      OAUTH2_PROXY_SET_XAUTHREQUEST: "true"
      OAUTH2_PROXY_PASS_USER_HEADERS: "true"
    volumes:
      - /opt/gcp-vdi/allowed_emails.txt:/etc/oauth2-proxy/allowed_emails.txt:ro

  broker:
    image: ${broker_image}
    container_name: gcp-vdi-broker
    network_mode: host
    restart: unless-stopped
    environment:
      BROKER_LISTEN_ADDR: ":8080"
      GCP_PROJECT_ID: "${project_id}"
      GCP_ZONE: "${zone}"
      GCE_INSTANCE_TEMPLATE: "${instance_template_self_link}"
      RUSTDESK_HOST: "${site_host}"
      RUSTDESK_PUB_KEY_FILE: "/var/lib/rustdesk/id_ed25519.pub"
      BROKER_REGISTER_SECRET: "${broker_register_secret}"
      ENABLE_BROWSER_FALLBACK: "${enable_browser_fallback}"
      BROKER_HOURLY_RATE_USD: "${desktop_hourly_rate_usd}"
      BROKER_MAX_VM_HOURS: "${max_vm_hours}"
    volumes:
      - /var/lib/gcp-vdi:/var/lib/gcp-vdi
      - /var/lib/rustdesk:/var/lib/rustdesk:ro
EOF

if [ "${embed_rustdesk}" = "true" ]; then
  cat <<'EOF' > /opt/gcp-vdi/rustdesk-compose.yml
${rustdesk_compose_yaml}
EOF
  docker compose -f /opt/gcp-vdi/rustdesk-compose.yml up -d
  # Publish RustDesk public key to GCS once generated so desktops auto-configure -k _
  for _ in $(seq 1 20); do
    if [ -f /var/lib/rustdesk/id_ed25519.pub ]; then
      gcloud storage cp /var/lib/rustdesk/id_ed25519.pub "gs://${home_bucket_name}/rustdesk/id_ed25519.pub" || true
      break
    fi
    sleep 2
  done
fi

if [ "${enable_browser_fallback}" = "true" ]; then
  mkdir -p /opt/gcp-vdi/guacamole
  FIRST_EMAIL=$(head -n1 /opt/gcp-vdi/allowed_emails.txt | tr '[:upper:]' '[:lower:]' | xargs)
  VM_HASH=$(printf '%s' "$FIRST_EMAIL" | sha256sum | cut -c1-12)
  cat <<EOF > /opt/gcp-vdi/guacamole/user-mapping.xml
<user-mapping>
  <authorize username="vdi" password="">
    <connection name="gcp-vdi-desktop">
      <protocol>rdp</protocol>
      <param name="hostname">vdi-$VM_HASH.${zone}.c.${project_id}.internal</param>
      <param name="port">3389</param>
      <param name="ignore-cert">true</param>
      <param name="security">any</param>
    </connection>
  </authorize>
</user-mapping>
EOF
  cat <<'EOF' > /opt/gcp-vdi/guac-compose.yml
services:
  guacd:
    image: guacamole/guacd:1.5.5
    container_name: guacd
    restart: unless-stopped
  guacamole:
    image: guacamole/guacamole:1.5.5
    container_name: guacamole
    ports:
      - "127.0.0.1:8081:8080"
    restart: unless-stopped
    environment:
      GUACD_HOSTNAME: "guacd"
      GUACD_PORT: "4822"
      GUACAMOLE_HOME: "/etc/guacamole"
      CATALINA_OPTS: "-Xms128m -Xmx256m"
    volumes:
      - /opt/gcp-vdi/guacamole:/etc/guacamole:ro
EOF
  docker compose -f /opt/gcp-vdi/guac-compose.yml up -d
fi

docker compose -f /opt/gcp-vdi/docker-compose.yml up -d --pull always
